# --- Hub (a2a_hub.py) ---
# Bind address. 127.0.0.1 for local-only; a Tailscale IP (100.x.y.z) for a
# private agent fleet. NEVER 0.0.0.0 on a public interface.
A2A_HUB_HOST=127.0.0.1
A2A_HUB_PORT=8787
A2A_TICK_SEC=20

# Hub owner's AgentMail identity: which inbox signs outgoing A2A messages.
A2A_HUB_SENDER_INBOX=you@agentmail.to
# API key for that inbox (or use the vault option below).
A2A_AGENTMAIL_API_KEY=am_us_...

# Optional: pull the key from a local vault CLI instead of env.
#A2A_VAULT_PY=/path/to/python
#A2A_VAULT=/path/to/vault.py
#A2A_VAULT_SITE=AgentMail
#VAULT_MASTER_PASSWORD=...

# Peer registry file (see config/peers.example.json).
#A2A_PEERS_FILE=./config/peers.json

# Optional daily agent<->agent transcript email. Empty = disabled.
A2A_TRANSCRIPT_EMAIL=
A2A_TRANSCRIPT_INTERVAL_SEC=86400

# Optional: webhook URL that receives JSON task events on terminal state
# (completed/failed/canceled). Empty = poll-only (default).
#A2A_PUSH_WEBHOOK=https://your-endpoint/a2a/events

A2A_AGENT_NAME=a2a-hub

# When AgentMail delivery to a peer fails (HTTP 403 or error key), the hub

# --- Transport precedence (Fetch.ai Agentverse / e2a.dev / AgentMail) ---
# A2A_TRANSPORT picks the PRIMARY outbound transport. The hub always falls back
# in the canonical order below, so a missing key/SDK never blocks routing:
#     agentverse  ->  e2a  ->  agentmail
# Transports a peer cannot use are dropped; the rest keep their order.
# MailSlurp was removed as a 4th fallback (2026-09-25).
A2A_TRANSPORT=agentverse
# Agentverse API key (minted for free from a Google-verified Fetch account).
# Keep it in env / vault, never in source. (av_...)
#A2A_AGENTVERSE_API_KEY=
# ...or pull it from the vault instead:
#A2A_AGENTVERSE_KEY_SITE=Agentverse
# Agentverse base URL (default https://agentverse.ai).
#A2A_AGENTVERSE_BASE=https://agentverse.ai
# The hub's own identity seed phrase (signs outbound envelopes; stays local).
#A2A_AGENTVERSE_SEED=
# Per-peer: add "agentverse_address" (the peer mailbox address) + optional
# "agentverse_seed" to that entry in config/peers.json. See a2a_agentverse.py.
# NOTE: requires the uagents SDK (`pip install uagents>=0.25.3`) to actually
# deliver; without it the hub degrades cleanly to AgentMail.

# --- Client (a2a_client.py) ---
A2A_ME_INBOX=myagent@agentmail.to
A2A_AGENTMAIL_API_KEY=am_us_...
A2A_HUB=http://127.0.0.1:8787

# --- Poller (poller.py) ---
A2A_INBOXES=myagent@agentmail.to
#A2A_ALERT_INBOX=you@agentmail.to
#A2A_OWNER_INBOX=you@agentmail.to
A2A_POLL_INTERVAL_SEC=300

# --- e2a.dev transport (primary for the 6-agent fleet) ---
# Two free accounts, three agents each. Browser-like User-Agent required.
E2A_API_KEY=e2a_acct_...
E2A2_API_KEY=e2a_acct_...
# or: E2A_API_KEYS=key1,key2  /  E2A_KEY_FILES=/path/e2a.env:/path/e2a2.env
#E2A_BASE=https://api.e2a.dev
# Hub sender identity on e2a
A2A_HUB_SENDER_E2A=jason-parser@agents.e2a.dev

# --- Agentverse (Fetch.ai) ---
#A2A_AGENTVERSE_API_KEY=eyJhbGci...
# Seed for the hub-side Agentverse identity (stays local).
# MUST be a REGISTERED fleet identity, or agent replies to hub-sent tasks come
# back `404 Target agent not found` and the answer is lost. The old default
# "a2a-omega-hub" derived agent1q03yav3l..., which has no mailbox. Leave unset
# to use SEED_PREFIX + A2A_HUB_IDENTITY (= the jason-parser fleet identity).
#A2A_AGENTVERSE_SEED=a2a-omega-e2a-fleet-jason-parser
#A2A_HUB_IDENTITY=jason-parser
#A2A_SEED_PREFIX=a2a-omega-e2a-fleet-

# --- omega_poller.py (per-agent Agentverse poller; the fleet's answering loop) ---
# Comma list of fleet agents THIS machine answers for.
A2A_OWN_AGENTS=omega-man
# Roster used by --batch fan-out (all six by default).
#A2A_FLEET=jason-parser,omega-man,my-liberclaw,my-betterclaw,omega-liberclaw,omega-betterclaw
#A2A_POLL_SEC=2
#A2A_LEDGER_DIR=./notes/ledger
# Per-agent brain: an OpenAI-compatible endpoint. With these set, agents answer
# for real instead of only acknowledging. A2A_ANSWER_PROFILES can override the
# model/persona per agent so each one answers as itself.
#A2A_ANSWER_BASE=http://127.0.0.1:4000/v1
#A2A_ANSWER_KEY=
#A2A_ANSWER_MODEL=
#A2A_ANSWER_PROFILES=./notes/answer_profiles.json
#A2A_ANSWER_MAX_TOKENS=400
#A2A_ANSWER_MAX_CHARS=800
# Where an answer goes when the sender is not a registered agent (reply 404s).
# Fleet name or agent1... address; empty disables redirection.
#A2A_REPLY_FALLBACK=jason-parser
# Retries per envelope before it is dropped, so one bad message cannot block a mailbox.
#A2A_MAX_ATTEMPTS=3
# How much of an inbound reply is transcribed to the actor log. Newlines are
# flattened so each entry stays one greppable line.
#A2A_INBOUND_LOG_CHARS=1200
