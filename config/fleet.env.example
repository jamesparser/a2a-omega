# Values with spaces MUST be quoted: this file is sourced by POSIX sh.

# Operator-local fleet identity. Copy to notes/fleet.env and fill in YOUR OWN
# agents. That path is gitignored (*.env), so real identities never reach the
# public repo. deploy/run_poller_one.sh and deploy/omega_poller_keeper.sh both
# source it automatically; override the location with A2A_FLEET_ENV.
#
# Why this file exists: every value here used to be a hardcoded default in the
# source. That meant a fresh clone signed envelopes as the maintainer's
# registered agent, redirected undeliverable answers into the maintainer's
# mailbox, and could start pollers against agents it did not own. There are no
# usable defaults now. The code refuses to act until you say who you are.

# --- Agentverse signing identity (REQUIRED) ---
# Must be an identity you registered yourself. An unregistered seed derives an
# address with no mailbox, so replies come back "404 Target agent not found"
# and the answer is silently lost.
A2A_HUB_IDENTITY=agent-one
A2A_SEED_PREFIX=a2a-myfleet-
# Or set the seed directly instead of prefix + identity:
#A2A_AGENTVERSE_SEED=a2a-myfleet-agent-one

# --- Roster ---
# Agents this machine answers for. Name only agents you own.
A2A_OWN_AGENTS=agent-one
# Full roster for broadcast / batch fan-out.
A2A_FLEET=agent-one,agent-two,agent-three
# Space-separated list for the supervisor (keeper).
A2A_KEEPER_AGENTS="agent-one agent-two agent-three"

# --- e2a lane ---
# Must be an inbox in an e2a account you control.
A2A_HUB_SENDER_E2A=agent-one@agents.e2a.dev
# Which names belong to which e2a account, for mesh_test.py.
#A2A_MESH_NAMES=agent-one,agent-two,agent-three
#A2A_MESH_ACCT1=agent-one
#A2A_MESH_ACCT2=agent-two,agent-three

# --- AgentMail lane (last resort) ---
# Where fallback-lane status reports go. Empty means "log only, mail nothing".
LCB_REPLY_TO=
# lcb_responder.py also reads its per-agent inboxes from lcb_agents.json
# (gitignored). See deploy/README.md for that file's shape.

# --- Answer redirection ---
# Where an answer goes when the envelope's sender is not a registered agent, so
# the reply does not 404 and vanish. One of YOUR names, or an agent1... address
# you own. Empty (default) disables redirection.
A2A_REPLY_FALLBACK=agent-one

# --- Persona / role injected into every answer ---
# QUOTE any value containing spaces. These files are sourced by POSIX sh
# (run_poller_one.sh, omega_poller_keeper.sh), where an unquoted
# A2A_FLEET_LABEL=this agent fleet assigns "this" and then tries to EXECUTE
# "agent fleet". The variable ends up empty and the persona silently loses its
# wording. Python-side .env loaders tolerate it; the shell does not.
A2A_FLEET_LABEL="this agent fleet"
A2A_AGENT_ROLE="an autonomous agent"

# --- Operator tooling ---
# deploy/verify_answers.py sender, and which agents it probes.
A2A_VERIFY_SENDER=agent-one
A2A_VERIFY_AGENTS=agent-one,agent-two,agent-three
# deploy/status-check.ps1 (Windows side).
#A2A_DIR=C:\work\a2a
#A2A_FLEET=agent-one,agent-two,agent-three
